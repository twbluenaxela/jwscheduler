generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth / multi-tenant ───────────────────────────────────────────────────────

model Congregation {
  id              Int          @id @default(autoincrement())
  name            String
  code            String       @unique  // short readable code e.g. "xinwu"
  inventoryReminderPersonId Int?
  inventoryReminderPerson Person? @relation("InventoryReminder", fields: [inventoryReminderPersonId], references: [id], onDelete: SetNull)
  literatureFormToken String? @unique
  inviteToken     String       @unique  @default(uuid())
  guestInviteToken String      @unique  @default(dbgenerated("gen_random_uuid()::text"))  // read-only GUEST join link
  meetingDayOffset Int         @default(2)
  meetingTime     String       @default("19:30")
  exceptions          Json         @default("[]")
  publishedSnapshot   Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  serviceCategories ServiceCategory[]
  serviceAssignments ServiceAssignment[]
  fieldServiceMeetings FieldServiceMeeting[]
  users           User[]
  weeks           MidweekWeek[]
  weekendRows     WeekendRow[]
  people          Person[]
  changeLogs      ChangeLog[]
  calendarFeeds   CalendarFeed[]
  publications    Publication[]
  literatureSubscriptions LiteratureSubscription[]
  literatureRequests LiteratureRequest[]
  literatureFormSubmissions LiteratureFormSubmission[]
  shipments Shipment[]
  inventoryCounts InventoryCount[]
  literatureDeliveries LiteratureDelivery[]
}

model User {
  id             Int           @id @default(autoincrement())
  firebaseUid    String        @unique
  email          String        @unique
  displayName    String?
  role           String        @default("VIEWER")  // "SYSADMIN" | "ADMIN" | "VIEWER"
  canLiterature  Boolean       @default(false)
  congregationId Int?
  congregation   Congregation? @relation(fields: [congregationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  mcpTokens      McpToken[]
}

// ── Congregation members ──────────────────────────────────────────────────────

model Person {
  id             Int          @id @default(autoincrement())
  congregationId Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  name           String
  gender         String       // "M" | "F"
  appointment    String       @default("")
  tags           String[]
  status         String       @default("active")
  awayNote       String?
  serviceGroup   String?
  groupRole      String?
  literatureNote String?
  assignmentNote String?
  assignmentIntervalMonths Int @default(0)
  lineUserId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  literatureSubscriptions LiteratureSubscription[]
  literatureRequests LiteratureRequest[]
  literatureFormSubmissions LiteratureFormSubmission[]
  literatureDeliveries LiteratureDelivery[]
  serviceAssignments ServiceAssignment[]
  fieldServiceMeetings FieldServiceMeeting[]
  calendarFeed CalendarFeed?
  inventoryReminderCongregations Congregation[] @relation("InventoryReminder")

  @@unique([congregationId, name])
}

// ── Midweek meetings ──────────────────────────────────────────────────────────

model MidweekWeek {
  id             Int          @id @default(autoincrement())
  congregationId Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  date           String       // display label, e.g. "6月 3日" (no year — see isoDate)
  isoDate        String?      // real meeting date "YYYY-MM-DD"; the authoritative one
  weekStartIso   String?      // real Monday date "YYYY-MM-DD" for schedule reapply
  dateLabel      String?
  weekStart      String?      // original EPUB Monday date — used for schedule reapply
  weekdayPill    String       @default("星期三 · 19:30")
  reading        String       @default("")
  openSong       String       @default("")
  midSong        String       @default("")
  closeSong      String       @default("")
  openSongTime   String?
  midSongTime    String?
  closeSongTime  String?
  openIntroTime  String?
  closingTime    String?
  closingDur     String?
  type           String       @default("normal") // "normal" | "special" | "assembly"
  label          String?      // free text badge, e.g. "區域大會", "分區監督探訪"
  parts          Part[]
  assignments    Assignment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Keyed on the REAL date: the display string repeats every year, so a
  // congregation holding two service years would collide on "9月 16日".
  @@unique([congregationId, isoDate])
  @@index([congregationId, isoDate])
}

model Part {
  id        Int         @id @default(autoincrement())
  weekId    Int
  week      MidweekWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  partKey   String
  section   String
  partNum   Int
  title     String
  scenario  String      @default("")
  dur       String
  cat       String
  roleLabel   String?
  time        String?
  cbsRef      String?
  hideHelper  Boolean  @default(false)

  @@unique([weekId, partKey])
}

model Assignment {
  id        Int         @id @default(autoincrement())
  slotId    String      @unique
  weekId    Int
  week      MidweekWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  name      String
  updatedAt DateTime    @updatedAt
}

// ── LINE registration state ──────────────────────────────────────────────────
// Tracks users mid-way through the two-step LINE linking flow
// (congregation chosen, waiting for name). Cleaned up once linking completes.

model LinePendingLink {
  lineUserId     String   @id
  congregationId Int
  createdAt      DateTime @default(now())
}

// ── Recent-changes log (總覽 ▸ 最近變更) ──────────────────────────────────────
// Append-only record of assignment edits (midweek + weekend), independent of
// LINE/publish. Written best-effort by /api/assignments and /api/weekend-rows/[id].

model ChangeLog {
  id             Int          @id @default(autoincrement())
  congregationId Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  slotId         String
  date           String       // meeting date string, e.g. "6月 3日" or "8/9"
  label          String       // role, e.g. "主席", "初次交談（學生）", "公眾演講"
  name           String?      // new assignee (null when cleared)
  prevName       String?      // previous assignee
  action         String       // "assign" | "clear" | "reassign"
  actorName      String?      // who made the change
  createdAt      DateTime     @default(now())

  @@index([congregationId, createdAt])
}

// ── Weekend meetings ──────────────────────────────────────────────────────────

model WeekendRow {
  id             Int          @id @default(autoincrement())
  congregationId Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  date           String       // display label, e.g. "8/9" (no year — see isoDate)
  isoDate        String?      // real meeting date "YYYY-MM-DD"; the authoritative one
  type           String       @default("schedule")
  no             String?
  topic          String?
  cong           String?
  speaker        String?
  chair          String?
  wt             String?
  read           String?
  host           String?
  away           String?
  label          String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Publication {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  code String
  name String
  category String
  hubGroup String?
  language String @default("CHT")
  format String @default("standard")
  itemNumber String?
  aliases String[]
  issue String?
  note String?
  onS28 Boolean @default(false)
  s28Order Int?
  active Boolean @default(true)
  requestable Boolean @default(true)
  orderable Boolean @default(true)
  specialOrder Boolean @default(false)
  countable Boolean?
  inventoryLines InventoryLine[]
  coverToken String? @unique
  cover PublicationCover?
  literatureRequests LiteratureRequest[]
  shipmentLines ShipmentLine[]
  literatureDeliveries LiteratureDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([congregationId, code, language, format])
  @@index([congregationId])
}

model PublicationCover {
  id Int @id @default(autoincrement())
  publicationId Int @unique
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mime String
  data Bytes
  updatedAt DateTime @updatedAt
}

model LiteratureSubscription {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  personId Int
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  series String
  language String @default("CHT")
  quantity Int @default(1)
  note String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([personId, series, language])
}

model LiteratureRequest {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  personId Int?
  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  publicationId Int
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  quantity Int @default(1)
  status String @default("pending")
  note String?
  source String @default("app")
  guestName String?
  guestNote String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries LiteratureDelivery[]
  @@index([congregationId, status])
}

model LiteratureFormSubmission {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  personId Int?
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  guestName String?
  guestNote String?
  note String?
  items Json
  flagged Boolean @default(false)
  reason String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  @@index([congregationId, createdAt])
}

model Shipment {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  slipNumber String
  shippedAt DateTime?
  source String @default("jwhub-pdf")
  note String?
  createdAt DateTime @default(now())
  lines ShipmentLine[]
  deliveries LiteratureDelivery[]
  @@unique([congregationId, slipNumber])
}

model ShipmentLine {
  id Int @id @default(autoincrement())
  shipmentId Int
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  publicationId Int
  publication Publication @relation(fields: [publicationId], references: [id])
  rawCode String
  quantity Int
}

model LiteratureDelivery {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  personId Int
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  publicationId Int
  publication Publication @relation(fields: [publicationId], references: [id])
  quantity Int
  shipmentId Int?
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  requestId Int?
  request LiteratureRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  deliveredAt DateTime @default(now())
  @@index([congregationId, publicationId])
}

model InventoryCount {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  month String
  status String @default("draft")
  source String @default("manual")
  completedAt DateTime?
  note String?
  lines InventoryLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([congregationId, month])
}

model InventoryLine {
  id Int @id @default(autoincrement())
  countId Int
  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  publicationId Int
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  opening Int @default(0)
  received Int @default(0)
  onHand Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([countId, publicationId])
}

model McpToken {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  tokenHash String @unique
  prefix String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
}

model CalendarFeed {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  personId Int @unique
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  token String @unique
  createdAt DateTime @default(now())
  lastFetchedAt DateTime?
}

model ServiceCategory {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  key String
  name String
  kind String
  positions String[]
  notes String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  assignments ServiceAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([congregationId, key])
}

model ServiceAssignment {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  categoryId Int
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date String
  position String
  personId Int?
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  text String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([categoryId, date, position])
  @@index([congregationId, date])
}

model FieldServiceMeeting {
  id Int @id @default(autoincrement())
  congregationId Int
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  date String
  time String
  place String
  leaderId Int?
  leader Person? @relation(fields: [leaderId], references: [id], onDelete: SetNull)
  territory String?
  note String?
  images FieldServiceImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([congregationId, date])
}

model FieldServiceImage {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting FieldServiceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mime String
  data Bytes
  token String @unique
  createdAt DateTime @default(now())
}
